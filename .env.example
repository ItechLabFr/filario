# URL publique de cette instance
FILARIO_URL=http://localhost:3000

# Secret long et aléatoire (32+ caractères)
AUTH_SECRET=change-me-with-a-long-random-secret

# PostgreSQL
DATABASE_URL=postgresql://filario:filario@postgres:5432/filario

# Identité WebAuthn / Passkeys
# Laisser vide pour déduire depuis FILARIO_URL
PASSKEY_RP_ID=
PASSKEY_RP_NAME=Filario

# Déploiement
NODE_ENV=production
PORT=3000
